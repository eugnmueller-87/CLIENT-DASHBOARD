# Copy this to .env and fill in your values

# Grafana Cloud remote_write endpoint
# Found at: grafana.com → your stack → Prometheus → Remote Write Endpoint
GRAFANA_CLOUD_URL=https://prometheus-prod-XX-prod-XX-X.grafana.net/api/prom/push

# Grafana Cloud numeric user ID (shown on the same page)
GRAFANA_CLOUD_USER=123456

# Grafana Cloud API key with MetricsPublisher role
# Create at: grafana.com → your stack → Access Policies → Create token
GRAFANA_CLOUD_API_KEY=glc_eyJ...

# Label applied to all metrics from this host (e.g. "metabelly-vps", "client-b-vps")
CLIENT_LABEL=metabelly-vps
